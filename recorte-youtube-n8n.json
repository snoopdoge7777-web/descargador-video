{
  "name": "Recorte de YouTube (Form + Discord)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Recortar video de YouTube",
        "formDescription": "Pegá el link y el rango de tiempo que querés recortar.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Link de YouTube",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Inicio (HH:MM:SS)",
              "fieldType": "text",
              "placeholder": "00:01:30",
              "requiredField": true
            },
            {
              "fieldLabel": "Fin (HH:MM:SS)",
              "fieldType": "text",
              "placeholder": "00:02:45",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Recortar"
        }
      },
      "id": "form-trigger",
      "name": "Formulario - Link de YouTube",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [240, 300],
      "webhookId": "recorte-youtube-form"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-SERVICIO.onrender.com/recortar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer TU_TOKEN_SECRETO"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"url\": $json['Link de YouTube'], \"inicio\": $json['Inicio (HH:MM:SS)'], \"fin\": $json['Fin (HH:MM:SS)'] } }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "http-request",
      "name": "Llamar Microservicio (Recorte)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ok",
      "name": "¿Salió Bien?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "¡Listo!",
        "completionMessage": "=Tu clip está en Discord: {{ $json.link_discord }}",
        "options": {}
      },
      "id": "form-ok",
      "name": "Mostrar Link de Discord",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Ocurrió un error",
        "completionMessage": "=No se pudo recortar el video: {{ $json.error }}",
        "options": {}
      },
      "id": "form-error",
      "name": "Mostrar Error",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Formulario - Link de YouTube": {
      "main": [
        [
          {
            "node": "Llamar Microservicio (Recorte)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Llamar Microservicio (Recorte)": {
      "main": [
        [
          {
            "node": "¿Salió Bien?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Salió Bien?": {
      "main": [
        [
          {
            "node": "Mostrar Link de Discord",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mostrar Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
